{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@supernote/tsconfig/next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@supernote/ui": ["../../packages/ui/src/index.ts"],
      "@supernote/core": ["../../packages/core/src/index.ts"],
      "@supernote/ipc": ["../../packages/ipc/src/index.ts"],
      "@supernote/canvas": ["../../packages/canvas/src/index.ts"],
      "@supernote/search": ["../../packages/search/src/index.ts"],
      "@supernote/formulas": ["../../packages/formulas/src/index.ts"],
      "@supernote/automations": ["../../packages/automations/src/index.ts"],
      "@supernote/git": ["../../packages/git/src/index.ts"],
      "@supernote/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@supernote/finance": ["../../packages/finance/src/index.ts"],
      "@supernote/finance/amortization": ["../../packages/finance/src/amortization/index.ts"],
      "@supernote/finance/seeds": ["../../packages/finance/src/seeds/index.ts"],
      "@supernote/finance/pricing": ["../../packages/finance/src/pricing/index.ts"],
      "@supernote/finance/snapshots": ["../../packages/finance/src/snapshots/index.ts"],
      "@supernote/views": ["../../packages/views/src/index.ts"],
      "@supernote/templates": ["../../packages/templates/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out"]
}
