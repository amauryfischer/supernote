{
  "name": "supernote",
  "private": true,
  "version": "0.0.0",
  "description": "Système de connaissance + CRM personnel local-first (PWA)",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "setup": "pnpm install && pnpm build:packages",
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @supernote/web dev",
    "build": "turbo run build",
    "scalingo-postbuild": "turbo run build --filter=@supernote/web",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "build:web": "pnpm --filter @supernote/web build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.59.1",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "electron"
    ]
  }
}
