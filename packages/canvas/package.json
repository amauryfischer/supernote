{
  "name": "@supernote/canvas",
  "version": "0.0.0",
  "private": true,
  "description": "Excalidraw-based canvas for Supernote with first-class entity references",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./dist/components/DrawLayer.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./excalidraw": {
      "types": "./dist/excalidraw/index.d.ts",
      "import": "./dist/excalidraw/index.js",
      "default": "./dist/excalidraw/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@supernote/core": "workspace:*",
    "@xyflow/react": "^12.10.2",
    "zustand": "^5.0.13"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
