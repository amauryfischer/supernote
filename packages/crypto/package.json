{
  "name": "@supernote/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "Age-based encryption engine for Supernote vault folders",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "age-encryption": "^0.1.1"
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0"
  }
}
