{
  "name": "@supernote/search",
  "version": "0.0.0",
  "private": true,
  "description": "FTS5 full-text search + ONNX semantic search + query language for Supernote",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fts": {
      "types": "./dist/fts/index.d.ts",
      "import": "./dist/fts/index.js",
      "default": "./dist/fts/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "import": "./dist/semantic/index.js",
      "default": "./dist/semantic/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js",
      "default": "./dist/query/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: no-op (ESLint non installé — cf. backlog)'"
  },
  "dependencies": {
    "@supernote/core": "workspace:*",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0",
    "@huggingface/transformers": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "better-sqlite3": "^11.0.0",
    "typescript": "^5.7.2"
  }
}
