{
  "name": "@supernote/sync",
  "version": "0.0.0",
  "private": true,
  "description": "Online realtime sync protocol — entity op-log, contracts and pure reducer logic shared by the web client and the sync server",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
