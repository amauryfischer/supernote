{
  "name": "@supernote/formulas",
  "version": "0.0.0",
  "private": true,
  "description": "Coda-like formula language — parser, AST, evaluator, stdlib",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supernote/core": "workspace:*"
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
