{
  "name": "@supernote/finance",
  "version": "0.0.0",
  "private": true,
  "description": "Finance module for Supernote — pricing engine, amortization, snapshots, entity type seeds",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "import": "./dist/pricing/index.js",
      "default": "./dist/pricing/index.js"
    },
    "./amortization": {
      "types": "./dist/amortization/index.d.ts",
      "import": "./dist/amortization/index.js",
      "default": "./dist/amortization/index.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots/index.d.ts",
      "import": "./dist/snapshots/index.js",
      "default": "./dist/snapshots/index.js"
    },
    "./seeds": {
      "types": "./dist/seeds/index.d.ts",
      "import": "./dist/seeds/index.js",
      "default": "./dist/seeds/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supernote/core": "workspace:*",
    "pino": "^10.3.1",
    "yahoo-finance2": "^2.13.3"
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
