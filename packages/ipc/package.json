{
  "name": "@supernote/ipc",
  "version": "0.0.0",
  "private": true,
  "description": "tRPC contracts for Supernote renderer ↔ main process IPC",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "import": "./dist/result/index.js"
    },
    "./schemas/vault": {
      "types": "./dist/schemas/vault.d.ts",
      "import": "./dist/schemas/vault.js"
    },
    "./schemas/entities": {
      "types": "./dist/schemas/entities.d.ts",
      "import": "./dist/schemas/entities.js"
    },
    "./schemas/schemas": {
      "types": "./dist/schemas/schemas.d.ts",
      "import": "./dist/schemas/schemas.js"
    },
    "./schemas/relations": {
      "types": "./dist/schemas/relations.d.ts",
      "import": "./dist/schemas/relations.js"
    },
    "./schemas/tags": {
      "types": "./dist/schemas/tags.d.ts",
      "import": "./dist/schemas/tags.js"
    },
    "./schemas/views": {
      "types": "./dist/schemas/views.d.ts",
      "import": "./dist/schemas/views.js"
    },
    "./schemas/automations": {
      "types": "./dist/schemas/automations.d.ts",
      "import": "./dist/schemas/automations.js"
    },
    "./schemas/git": {
      "types": "./dist/schemas/git.d.ts",
      "import": "./dist/schemas/git.js"
    },
    "./schemas/search": {
      "types": "./dist/schemas/search.d.ts",
      "import": "./dist/schemas/search.js"
    },
    "./schemas/system": {
      "types": "./dist/schemas/system.d.ts",
      "import": "./dist/schemas/system.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@trpc/server": "^11.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
