{
  "name": "@supernote/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Ollama bridge + auto-tagging + classifier + action extractor for Supernote",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ollama": {
      "types": "./dist/ollama/index.d.ts",
      "import": "./dist/ollama/index.js",
      "default": "./dist/ollama/index.js"
    },
    "./auto-tag": {
      "types": "./dist/auto-tag/index.d.ts",
      "import": "./dist/auto-tag/index.js",
      "default": "./dist/auto-tag/index.js"
    },
    "./classifier": {
      "types": "./dist/classifier/index.d.ts",
      "import": "./dist/classifier/index.js",
      "default": "./dist/classifier/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "import": "./dist/extract/index.js",
      "default": "./dist/extract/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts/index.js",
      "default": "./dist/prompts/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "default": "./dist/agent/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@supernote/core": "workspace:*",
    "pino": "^9.6.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@supernote/search": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@supernote/search": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
