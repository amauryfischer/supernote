{
  "name": "@supernote/git",
  "version": "0.0.0",
  "private": true,
  "description": "Isomorphic-git wrappers for Supernote automatic versioning",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supernote/core": "workspace:*",
    "isomorphic-git": "^1.37.6",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@supernote/tsconfig": "workspace:*",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
